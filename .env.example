# Call Intelligence — Required Credentials
# Store these as Pipedream environment variables, never hardcode in steps.
# Apollo call data reaches this pipeline via Apollo's native HubSpot sync
# (not a direct Apollo API call), so no Apollo credential is needed here.

ANTHROPIC_API_KEY=your_anthropic_api_key_here
HUBSPOT_ACCESS_TOKEN=your_hubspot_private_app_token_here
