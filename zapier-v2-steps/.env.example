# Call Intelligence v2 — Partner-Sync Pipeline — Required Credentials
# Store these as Zapier Environment Variables on each Code by Zapier step that needs
# them (Code step → Settings → Environment Variables), not hardcoded in the script body.
#
# Unlike the old Pipedream pipeline (../pipedream-steps/), this version polls Apollo's
# API directly instead of relying on Apollo's native HubSpot sync + a HubSpot webhook —
# so it needs an Apollo credential that the old pipeline didn't.

APOLLO_API_KEY=your_apollo_api_key_here
ANTHROPIC_API_KEY=your_anthropic_api_key_here
HUBSPOT_ACCESS_TOKEN=your_hubspot_private_app_token_here
